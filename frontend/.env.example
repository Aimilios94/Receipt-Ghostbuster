# Receipt Ghostbuster frontend config (Vite — only VITE_* vars reach the browser).
# The frontend talks ONLY to the FastAPI backend. All secrets stay server-side.
VITE_API_BASE_URL=http://localhost:8000

# --- Sentry browser error tracking (OPTIONAL, opt-in) ---
# No-op unless VITE_SENTRY_DSN is set. A DSN is a public ingest key (safe in the
# browser), but keep it in the git-ignored .env rather than this committed template.
# Errors only — no performance tracing — to stay inside Sentry's free tier.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
