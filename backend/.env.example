# ---- Receipt Ghostbuster — backend secrets (server-side ONLY) ----
# Copy this file to `.env` in the same folder and fill in real values.
# NEVER commit .env. NEVER put real keys in THIS file — it is committed as a template.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: full access, server-side only. Do NOT expose to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key
# Storage bucket that holds uploaded receipt images.
SUPABASE_RECEIPTS_BUCKET=receipts
# JWT secret (Supabase > Settings > API > JWT Secret) — verifies frontend tokens.
SUPABASE_JWT_SECRET=your-jwt-secret
# Local/demo owner id used ONLY when no JWT is present. Leave blank once auth works.
# Tip: after creating a user in Supabase Auth, paste that user's UUID here to demo.
DEV_USER_ID=

# --- Vision LLM (receipt extraction) ---
# provider: anthropic | openai | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini   # reasoning model; reads dense VAT tables best (see eval/RESULTS.md)

# --- Extraction confidence gate ---
# Extractions at or above this land as `posted`; below go to the review queue.
CONFIDENCE_THRESHOLD=0.8

# --- Reconciliation tuning ---
# Amount match tolerance in currency units, and date window in days.
RECONCILE_AMOUNT_TOLERANCE=0.01
RECONCILE_DATE_WINDOW_DAYS=3
# Minimum fuzzy vendor-name score (0-100) to accept a match.
RECONCILE_VENDOR_MIN_SCORE=70

# --- App ---
DEFAULT_CURRENCY=EUR
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- n8n (Phase 2: push an approved cancel/refund draft to Gmail drafts) ---
# Webhook URL of the imported "refund-draft-to-gmail" workflow. Draft-only; never
# sends. Leave blank until n8n + the Gmail credential are set up (see /n8n/README.md).
N8N_WEBHOOK_URL=

# --- Structured output (Instructor) ---
# How many times to re-prompt the model when its output fails schema validation
# before falling back to tolerant JSON parsing.
INSTRUCTOR_MAX_RETRIES=2

# --- LangSmith tracing (OPTIONAL, opt-in) ---
# Off by default — the app and the offline eval need none of this. When enabled with
# a key, every LLM call is also traced to your LangSmith project (latency/tokens/
# prompt/response) and scripts/langsmith_eval.py can run the eval as an Experiment.
# PRIVACY: with this ON, receipt images and prompts are sent to LangSmith's cloud.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=receipt-ghostbuster

# --- Sentry error tracking (OPTIONAL, opt-in) ---
# App-layer error tracking (unhandled 500s + the exceptions the pipeline swallows).
# Off unless SENTRY_DSN is set. Errors only — SENTRY_TRACES_SAMPLE_RATE=0.0 keeps
# performance tracing off, well inside the free tier. PRIVACY: initialised with
# send_default_pii=False + a before_send scrubber (services/monitoring.py) that strips
# request body/headers, so no receipt/bank/PII is sent. See docs/MONITORING.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
